{
  "name": "Shelf Shelf — App Launcher, Dock & To-Do",
  "short_name": "Shelf Shelf",
  "description": "Your favorite websites as beautiful apps, folders and a dock — plus to-dos with reminders.",
  "start_url": "./",
  "scope": "./",
  "id": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#F2F2F7",
  "theme_color": "#F2F2F7",
  "categories": ["productivity", "utilities"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Add App", "short_name": "Add", "url": "./?new=1", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Today’s To-Dos", "short_name": "To-Do", "url": "./?todo=today", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": { "title": "name", "text": "text", "url": "add" }
  }
}
